{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaOptions": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "event-service-consumer",
    "ProduceEventsTopic": "event-service-events",
    "ConsumeEventsTopics": [],
    "AutoOffsetReset": "Earliest",
    "DeadLetterTopic": "event-service-events-dlq",
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000
  },
  "OutboxOptions": {
    "BatchSize": 50,
    "PollingIntervalMs": 5000,
    "MaxRetryAttempts": 5
  },
  "ApiSettings": {
    "Port": 5000,
    "CorsOrigins": []
  },
  "PgAdminSettings": {
    "DefaultEmail": "",
    "DefaultPassword": "",
    "Port": 5050
  }
}
