{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaOptions": {
    "userprofile": {
      "BootstrapServers": "kafka:29092",
      "ConsumerGroupId": "userprofile-consumer",
      "ProduceEventsTopic": "userprofile-events",
      "ConsumeEventsTopics": [],
      "AutoOffsetReset": "Earliest",
      "DeadLetterTopic": "userprofile-events-dlq",
      "MaxRetryAttempts": 3,
      "RetryDelayMs": 1000
    }
  },
  "ApiOptions": {
    "Port": 5000,
    "CorsOrigins": []
  },
  "PgAdminOptions": {
    "DefaultEmail": "",
    "DefaultPassword": "",
    "Port": 5050
  }
}