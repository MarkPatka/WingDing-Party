# --- General ---
ASPNETCORE_ENVIRONMENT=Development
DOCKER_REGISTRY=

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Service Databases ---
USER_POSTGRES_DB=userdb
AUTH_POSTGRES_DB=authdb
EVENT_POSTGRES_DB=eventdb
CLUB_POSTGRES_DB=clubdb

# --- API Ports (host:container) ---
USER_API_PORT=5100
AUTH_API_PORT=5200
EVENT_API_PORT=5300
CLUB_API_PORT=5400

# --- PgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Kafka ---
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Minio ---
MINIO_PORT = 9000
MINIO_USER = minio
MINIO_PASSWORD = minio

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=18080

# --- Redis ---
REDIS_PORT=6379
